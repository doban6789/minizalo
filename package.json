{
  "name": "minizalo",
  "version": "0.1.0",
  "description": "MiniZalo — open-source Electron tool to manage up to 6 personal Zalo accounts with a local REST/WS/webhook/CLI gateway for AI agents & n8n. Built on zca-js.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "",
  "workspaces": [
    "core",
    "cli"
  ],
  "scripts": {
    "build:core": "npm run build --workspace @minizalo/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "core:dev": "npm run dev --workspace @minizalo/core",
    "core:start": "npm run start --workspace @minizalo/core",
    "cli": "npm run --workspace @minizalo/cli start --",
    "test": "npm run test --workspaces --if-present"
  },
  "keywords": [
    "zalo",
    "zca-js",
    "electron",
    "automation",
    "n8n",
    "ai-agent"
  ]
}
