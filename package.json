{
  "name": "minizalo",
  "version": "0.1.0",
  "description": "MiniZalo — open-source Electron tool to manage up to 6 personal Zalo accounts with a local REST/WS/webhook/CLI gateway for AI agents & n8n. Built on zca-js.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "MiniZalo contributors",
  "main": "./out/main/index.js",
  "workspaces": [
    "core",
    "cli"
  ],
  "scripts": {
    "build:core": "npm run build --workspace @minizalo/core",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.electron.json --noEmit",
    "core:dev": "npm run dev --workspace @minizalo/core",
    "core:start": "npm run start --workspace @minizalo/core",
    "cli": "npm run --workspace @minizalo/cli start --",
    "test": "npm run test --workspaces --if-present",
    "predev": "npm run build:core",
    "dev": "electron-vite dev",
    "precompile": "npm run build:core",
    "compile": "electron-vite build",
    "dist": "npm run compile && electron-builder",
    "dist:linux": "npm run compile && electron-builder --linux",
    "dist:win": "npm run compile && electron-builder --win",
    "dist:mac": "npm run compile && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@minizalo/core": "*"
  },
  "devDependencies": {
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7"
  },
  "keywords": [
    "zalo",
    "zca-js",
    "electron",
    "automation",
    "n8n",
    "ai-agent"
  ]
}
