{
  "name": "minizalo-core",
  "version": "0.2.0",
  "description": "MiniZalo headless core: Fastify REST/WS gateway, SQLite, zca-js account manager, webhook dispatcher. Runs standalone (Node) or embedded in Electron.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/vuongnguyenbinh/minizalo#readme",
  "repository": { "type": "git", "url": "git+https://github.com/vuongnguyenbinh/minizalo.git", "directory": "core" },
  "bugs": "https://github.com/vuongnguyenbinh/minizalo/issues",
  "keywords": ["zalo", "zca-js", "fastify", "sqlite", "ai-agent", "n8n"],
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "minizalo-core": "./dist/standalone.js"
  },
  "scripts": {
    "dev": "tsx watch src/standalone.ts",
    "start": "tsx src/standalone.ts",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx ./test/*.test.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.2",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.2.1",
    "image-size": "^2.0.2",
    "zca-js": "^2.1.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
